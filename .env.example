# Project Configuration
PROJECT_NAME="SuryaNet"
API_V1_STR="/api/v1"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# TimescaleDB / PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5433
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="suryanet"

# Async database URL (for asyncpg)
DATABASE_ASYNC_URL="postgresql+asyncpg://postgres:CHANGE_ME@localhost:5433/suryanet"

# Sync database URL (for migrations/sync operations if needed)
DATABASE_SYNC_URL="postgresql://postgres:CHANGE_ME@localhost:5433/suryanet"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"
