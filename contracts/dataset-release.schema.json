{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:adityanet:contract:dataset-release:1",
  "title": "DatasetRelease",
  "description": "An immutable, digest-addressed snapshot of canonical tables. The citable unit (ADR-0006).",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "version", "digest", "tables", "frozen_at", "n_files", "total_bytes"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Mutable name. Never referenced by an Evaluation — releases are referenced by digest (ADR-0005)."
    },
    "version": { "type": "string", "minLength": 1 },
    "digest": { "$ref": "urn:adityanet:contract:common:1#/$defs/digest" },
    "frozen_at": { "$ref": "urn:adityanet:contract:common:1#/$defs/timestamp" },
    "n_files": { "type": "integer", "minimum": 1 },
    "total_bytes": { "type": "integer", "minimum": 0 },
    "tables": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "digest", "n_files", "bytes"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][0-9]+$" },
          "name": { "type": "string", "minLength": 1 },
          "digest": { "$ref": "urn:adityanet:contract:common:1#/$defs/digest" },
          "n_files": { "type": "integer", "minimum": 0 },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      },
      "description": "Per-table digests rolling up to the release digest, so a changed byte anywhere is locatable."
    },
    "doi": {
      "type": ["string", "null"],
      "description": "Tier 1 deposition identifier, null before deposition or when the fallback path was used. Its absence degrades citability and is published rather than hidden (ADR-0023)."
    }
  }
}
