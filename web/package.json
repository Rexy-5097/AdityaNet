{
  "name": "adityanet-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AdityaNet Web Platform \u2014 independent research platform over the public Aditya-L1 X-ray archive.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "dev": "astro dev",
    "build": "astro build && tsx scripts/postbuild.ts",
    "preview": "astro preview",
    "verify": "tsx scripts/generate.ts --check && astro check && tsc --noEmit && eslint .",
    "test": "vitest run",
    "budget": "tsx scripts/check.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "astro": "7.1.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "postprocessing": "^6.39.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@eslint/js": "^9.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-boundaries": "^7.1.0",
    "marked": "^18.0.7",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.28.2"
}
