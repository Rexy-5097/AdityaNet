---
/**
 * Root document layout.
 *
 * Fonts are vendored through Fontsource rather than fetched from a font CDN or
 * downloaded at build time. Three reasons, in order of weight:
 *   1. No external origin at runtime, which is what lets the CSP forbid them outright.
 *   2. No network access required to build, so the build is reproducible offline and
 *      cannot change because a third party reissued a file.
 *   3. Deterministic bytes, which the project values everywhere else too.
 *
 * Two families only (Amendment R-B). The surviving epistemic distinction is
 * sans = interface, mono = measurement.
 */
// Latin subsets only. Fontsource's unsuffixed entrypoints (`400.css`) pull every
// subset it publishes — Cyrillic, Greek, Vietnamese — which emitted 28 font files
// for an English-language scientific platform. `unicode-range` means a browser
// would not have downloaded them, but they were still built, hashed, and deployed.
import "@fontsource/ibm-plex-sans/latin-300.css";
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@/styles/global.css";
import Header from "@/components/shell/Header.astro";
import ResourceIndex from "@/components/shell/ResourceIndex.astro";

interface Props {
  title: string;
  description: string;
  /** Full-bleed surfaces (the landing scene) reach the top edge under the fixed header. */
  bleed?: boolean;
  /**
   * The landing scene suppresses the reference index. It is a single held shot with one
   * instruction — scroll — and a nine-link directory under it would answer a question the
   * viewer has not yet been given a reason to ask.
   */
  index?: boolean;
}

const { title, description, bleed = false, index = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="dark" />
    {/*
      No open-graph image. There is no photography anywhere in this platform, and a
      generated social card would assert nothing measured. When the experience layer
      ships, its card must carry the Domain A watermark or it must not exist.
    */}
  </head>

  <body class="min-h-screen">
    {/* First focusable element on every page. */}
    <a
      href="#main"
      class="sr-only focus-visible:not-sr-only focus-visible:absolute focus-visible:top-2 focus-visible:left-2 focus-visible:z-50 focus-visible:rounded-sm focus-visible:bg-raised focus-visible:px-3 focus-visible:py-2 focus-visible:text-fg"
    >
      Skip to content
    </a>

    {/* Reading progress. CSS scroll-timeline — zero JavaScript. */}
    <div class="progress-rail" aria-hidden="true"></div>

    <Header />

    {/* Named so cross-document view transitions can animate the content region while
        the header persists — the seam that makes six surfaces read as one product. */}
    <div class:list={["page-content", bleed && "page-content--bleed"]} style="view-transition-name: page-content">
      <slot />
    </div>

    {/*
      The affiliation firewall. This appears on every route, not only the entry page.
      The cost of under-claiming is zero; the cost of over-claiming is the project.
    */}
    <footer class="mx-auto max-w-5xl px-6 pt-8 pb-20 text-xs leading-relaxed text-fg-muted">
      <hr class="rule mb-8" />
      {index && <ResourceIndex />}
      {index && <hr class="rule my-8" />}
      <p class="max-w-2xl">
        AdityaNet is an independent research project. It is not affiliated with,
        endorsed by, or operated by ISRO or any space agency. It is built on publicly
        available Aditya-L1 archive data from ISSDC.
      </p>
    </footer>
  </body>
</html>
