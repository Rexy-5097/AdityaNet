---
/**
 * A surface that exists in navigation but is not yet built.
 *
 * Stub pages are a credibility risk. A "coming soon" splash that implies imminence,
 * or worse shows placeholder figures, is exactly the small dishonesty this platform
 * cannot afford — and it is the failure mode that made "Research (papers/DOI)" get
 * cut from the information architecture in the first place.
 *
 * So a planned surface states plainly what it will contain, which committed artifacts
 * it will draw from, and which sprint delivers it. Listing the artifacts is itself
 * informative: it tells a reviewer the evidence already exists and is merely
 * unpublished, which is true and checkable.
 */
interface Props {
  title: string;
  purpose: string;
  sprint: string;
  artifacts: readonly string[];
}

const { title, purpose, sprint, artifacts } = Astro.props;
---

<main id="main" class="mx-auto max-w-2xl px-6 pt-16 pb-16">
  <h1 class="text-xl font-semibold tracking-tight">{title}</h1>

  <p class="mt-4 text-base leading-relaxed">{purpose}</p>

  <section
    class="mt-8 rounded-md border border-line-subtle bg-surface p-4"
    aria-labelledby="planned-heading"
  >
    <h2 id="planned-heading" class="text-xs font-medium tracking-wide text-fg-muted uppercase">
      Not yet published
    </h2>

    <p class="mt-2 text-sm text-fg-muted">
      This surface is scheduled for <strong class="font-medium text-fg">{sprint}</strong>.
      Nothing is shown here rather than showing something provisional.
    </p>

    <h3 class="mt-5 text-xs font-medium tracking-wide text-fg-muted uppercase">
      Source artifacts
    </h3>
    <ul class="mt-2 space-y-1 font-mono text-2xs text-fg-subtle">
      {artifacts.map((artifact) => <li class="break-all">{artifact}</li>)}
    </ul>
    <p class="mt-3 text-xs text-fg-subtle">
      These are committed to the repository. Every figure this surface eventually shows
      will resolve to one of them; none will be written by hand.
    </p>
  </section>
</main>
